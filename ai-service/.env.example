# ===== 运行模式 =====
# auto（默认）：填写 DEEPSEEK_API_KEY 即使用真实模型，未填写自动降级为 mock
# mock：强制演示模式，不调用大模型，全部接口可离线跑通
# real：强制真实模式，缺少 key 时启动直接报错
AI_MODE=auto

# ===== DeepSeek（OpenAI 兼容接口）=====
# 在 https://platform.deepseek.com 申请，仅填写在本地 ai-service/.env，不要提交到代码库
# 留空则 auto 模式自动降级 mock，全部接口仍可离线演示
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=90
LLM_RETRIES=2

# ===== Embeddings（契约 v1.2 §1 B 轨：可插拔，默认 local）=====
# DeepSeek 没有 /embeddings 接口，默认使用本地确定性哈希向量，无需任何外部服务。
# 若你另有 OpenAI 兼容的 embedding 服务（如硅基流动 BGE-M3、OpenAI、自建 vLLM），
# 可改为 openai 并填写下面三项；缺 key / 调用失败 / 维度异常时会自动回退 local。
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 语义 embedding 的「知识库命中」阈值：无关问题基线 0.28~0.39、相关问题 0.70~0.99，
# 因此 openai 方案默认 0.40（local 方案仍用下面的 RETRIEVAL_MIN_SCORE=0.15）
EMBEDDING_MIN_SCORE=0.40

# ===== 图片识别 / Vision（契约 v1.3）=====
# DeepSeek 无 vision 接口；图片答疑走 OpenAI 兼容的视觉模型（默认硅基流动 Qwen3-VL）。
# auto：VISION_API_KEY 非空（或回退 EMBEDDING_API_KEY）即启用；none：关闭图片识别。
VISION_PROVIDER=auto
VISION_BASE_URL=https://api.siliconflow.cn/v1
VISION_API_KEY=
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
VISION_TIMEOUT_SECONDS=60

# ===== 查询扩展（契约 v1.2 §1 A 轨）=====
# auto：real 模式下用 DeepSeek 做检索查询改写（失败自动回退本地规则扩展）
# off：只用本地规则同义扩展
QUERY_EXPANSION=auto

# ===== 检索与分块（一般无需修改）=====
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.15
CHUNK_MIN_CHARS=600
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=100

# ===== 目录与 CORS（可选，默认值见 app/config.py）=====
# AI_KNOWLEDGE_DIR=knowledge
# AI_DATA_DIR=data
# Gate 前置自测状态（v1.4.1）：默认 data/gate.db，删除即清空；TTL 2 小时
# AI_GATE_DB=data/gate.db
# AI_UPLOAD_DIR=knowledge/uploads
# AI_KNOWLEDGE_STATE=data/knowledge_state.json
# AI_KP_FILE=knowledge/knowledge_points.json
# UPLOAD_MAX_BYTES=2097152
# AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
